# Release signing key for local builds. Copy this file to keystore.properties
# (ignored by git) and fill in the password. Without keystore.properties, the
# release build is unsigned unless the PBILL_KEYSTORE_* environment variables
# are set (GitHub Actions).
# Absolute path (~ is not expanded)
storeFile=/path/to/the/p12/file
storePassword=
keyAlias=
keyPassword=
